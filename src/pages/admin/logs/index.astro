---
// Admin: Invoice operation logs (dev-mode capture surface)
// Route: /admin/plugins/invoicing/logs
import AdminLayout from 'pelerin:admin-layout';
import { createPluginContext } from 'pelerin:plugin-sdk';
import { listDevLogs } from '../../../lib/data/logs.ts';
import { isDevMode } from '../../../lib/dev-mode.ts';

const sdk = createPluginContext();
const user = await sdk.auth.requireAdmin(Astro.request);
const devMode = isDevMode();

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 20;
const filterOperation = url.searchParams.get('operation') || '';
const filterResolution = url.searchParams.get('resolution') || '';

const result = await listDevLogs(sdk.db, {
  page,
  pageSize,
  operation: filterOperation || undefined,
  resolution: filterResolution || undefined,
});
const logs = result.data;
const total = result.total;
const totalPages = Math.max(1, Math.ceil(total / pageSize));

function resolutionBadge(resolution: string): string {
  return resolution === 'decided' ? 'badge-success' : 'badge-warning';
}

function buildFilterParams(p: number): string {
  const params = new URLSearchParams();
  if (filterOperation) params.set('operation', filterOperation);
  if (filterResolution) params.set('resolution', filterResolution);
  params.set('page', String(p));
  return params.toString();
}

const hasFilters = filterOperation || filterResolution;
---

<AdminLayout title="Operation Logs" currentPath="/admin/plugins/invoicing/logs" user={user}>
  <div class="col-span-12">
    {
      devMode && (
        <div class="alert alert-info mb-6">
          <span>
            <strong>Dev mode is on.</strong> Invoice operations are captured (not sent to the
            provider) and can be resolved from each log's detail page.
          </span>
        </div>
      )
    }

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">Operation Logs</h1>
      <span class="text-sm text-base-content/60">{total} total entries</span>
    </div>

    <form method="GET" class="flex gap-4 mb-6 flex-wrap items-end">
      <div class="form-control">
        <label class="label"><span class="label-text">Operation</span></label>
        <select name="operation" class="select select-bordered">
          <option value="">All</option>
          {
            ['emit', 'retry', 'print', 'storno', 'cancel'].map((op) => (
              <option value={op} selected={filterOperation === op}>
                {op}
              </option>
            ))
          }
        </select>
      </div>
      <div class="form-control">
        <label class="label"><span class="label-text">Resolution</span></label>
        <select name="resolution" class="select select-bordered">
          <option value="">All</option>
          <option value="pending" selected={filterResolution === 'pending'}> Pending </option>
          <option value="decided" selected={filterResolution === 'decided'}> Decided </option>
        </select>
      </div>
      <div class="form-control">
        <label class="label">
          <span class="label-text opacity-0">&nbsp;</span>
        </label>
        <button type="submit" class="btn btn-outline">Filter</button>
      </div>
      {
        hasFilters && (
          <div class="form-control">
            <label class="label">
              <span class="label-text opacity-0">&nbsp;</span>
            </label>
            <a href="/admin/plugins/invoicing/logs" class="btn btn-ghost">
              Clear
            </a>
          </div>
        )
      }
    </form>

    {
      logs.length === 0 ? (
        <p class="text-base-content/60">No log entries found.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Date</th>
                <th>Operation</th>
                <th>Invoice</th>
                <th>From</th>
                <th>Resolution</th>
                <th />
              </tr>
            </thead>
            <tbody>
              {logs.map((log: any) => (
                <tr>
                  <td class="text-sm">
                    {new Date(log.created_at).toLocaleDateString()}
                    <br />
                    <span class="text-xs text-base-content/50">
                      {new Date(log.created_at).toLocaleTimeString()}
                    </span>
                  </td>
                  <td>
                    <span class="badge badge-ghost">{log.operation}</span>
                  </td>
                  <td class="font-mono text-xs">{log.invoice_id || '—'}</td>
                  <td>
                    <span class="badge badge-ghost">{log.from_status}</span>
                  </td>
                  <td>
                    <span class={`badge badge-sm ${resolutionBadge(log.resolution)}`}>
                      {log.resolution}
                    </span>
                  </td>
                  <td>
                    <a
                      href={`/admin/plugins/invoicing/logs/${log.id}`}
                      class="btn btn-ghost btn-xs"
                    >
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    {
      totalPages > 1 && (
        <div class="join mt-4">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
            <a
              href={`/admin/plugins/invoicing/logs?${buildFilterParams(p)}`}
              class={`join-item btn btn-sm ${p === page ? 'btn-active' : ''}`}
            >
              {p}
            </a>
          ))}
        </div>
      )
    }
  </div>
</AdminLayout>
